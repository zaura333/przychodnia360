  "components" : {
    "schemas" : {
      "ContactRequest" : {
        "type" : "object",
        "properties" : {
          "contactEmail" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          }
        }
      },
      "CreatePatientRequest" : {
        "type" : "object",
        "properties" : {
          "birthDate" : {
            "type" : "string",
            "format" : "date"
          },
          "contactEmail" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "firstName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "lastName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "birthDate", "firstName", "lastName" ]
      },
      "CreateTenantAdminRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          }
        },
        "required" : [ "email" ]
      },
      "CreateTenantRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "slug" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "^[a-z0-9][a-z0-9-]{1,62}$"
          }
        },
        "required" : [ "name", "slug" ]
      },
      "FacilityResponse" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "name", "slug" ]
      },
      "HealthResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string"
          }
        },
        "required" : [ "status" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "tenantSlug" : {
            "type" : "string",
            "maxLength" : 63,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password", "tenantSlug" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "employeeId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "patientId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "PATIENT", "DOCTOR", "MEDICAL_STAFF", "RECEPTIONIST", "TENANT_ADMIN", "PLATFORM_ADMIN" ]
          },
          "slotStepMinutes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "tenantId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "tenantName" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "role", "userId" ]
      },
      "OwnTenantResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name", "slug" ]
      },
      "PageResponsePatientResponse" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PatientResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "total" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "items", "page", "size", "total" ]
      },
      "PasswordResetConfirmRequest" : {
        "type" : "object",
        "properties" : {
          "newPassword" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "token" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "newPassword", "token" ]
      },
      "PasswordResetRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "tenantSlug" : {
            "type" : "string",
            "maxLength" : 63,
            "minLength" : 0
          }
        },
        "required" : [ "email", "tenantSlug" ]
      },
      "PatientResponse" : {
        "type" : "object",
        "properties" : {
          "birthDate" : {
            "type" : "string",
            "format" : "date"
          },
          "contactEmail" : {
            "type" : "string"
          },
          "firstName" : {
            "type" : "string"
          },
          "hasAccount" : {
            "type" : "boolean"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lastName" : {
            "type" : "string"
          }
        },
        "required" : [ "birthDate", "firstName", "hasAccount", "id", "lastName" ]
      },
      "PlatformLoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "RegisterPatientRequest" : {
        "type" : "object",
        "properties" : {
          "birthDate" : {
            "type" : "string",
            "format" : "date"
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "firstName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "lastName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "tenantSlug" : {
            "type" : "string",
            "maxLength" : 63,
            "minLength" : 0
          }
        },
        "required" : [ "birthDate", "email", "firstName", "lastName", "password", "tenantSlug" ]
      },
      "SearchRequest" : {
        "type" : "object",
        "properties" : {
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "query" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
