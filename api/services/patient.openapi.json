{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Wersja demonstracyjna, dane wyłącznie syntetyczne.",
    "title" : "Przychodnia360 API (patient)",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/v1/health" : {
      "get" : {
        "description" : "Dostęp: publiczny.",
        "operationId" : "getHealth",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Stan aplikacji (bez bazy)",
        "tags" : [ "health-controller" ]
      }
    },
    "/api/v1/health/db" : {
      "get" : {
        "description" : "Dostęp: publiczny w local/test.",
        "operationId" : "getHealthDb",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Stan aplikacji z zapytaniem do bazy (tylko local/test)",
        "tags" : [ "health-controller" ]
      }
    },
    "/api/v1/me/patient" : {
      "get" : {
        "description" : "Dostęp: PATIENT_READ_OWN (PATIENT).",
        "operationId" : "getMyPatient",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PatientResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Dane własne pacjenta",
        "tags" : [ "patient-controller" ]
      },
      "patch" : {
        "description" : "Dostęp: PATIENT_EDIT_OWN (PATIENT). W 1a tylko e-mail kontaktowy.",
        "operationId" : "updateMyPatient",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ContactRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PatientResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Edycja własnych danych kontaktowych",
        "tags" : [ "patient-controller" ]
      }
    },
    "/api/v1/reception/patients" : {
      "post" : {
        "description" : "Dostęp: PATIENT_REGISTER (RECEPTIONIST). Konto pacjenta zakłada się osobno.",
        "operationId" : "registerPatientByReceptionist",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreatePatientRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PatientResponse"
                }
              }
            },
            "description" : "Created"
          }
        },
        "summary" : "Założenie rekordu pacjenta",
        "tags" : [ "patient-controller" ]
      }
    },
    "/api/v1/reception/patients/search" : {
      "post" : {
        "description" : "Dostęp: PATIENT_SEARCH (RECEPTIONIST). Fraza w ciele żądania, bez danych medycznych.",
        "operationId" : "searchPatients",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SearchRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponsePatientResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Wyszukiwanie pacjentów po imieniu i nazwisku",
        "tags" : [ "patient-controller" ]
      }
    },
    "/api/v1/reception/patients/{id}/contact" : {
      "patch" : {
        "description" : "Dostęp: PATIENT_CONTACT_EDIT (RECEPTIONIST).",
        "operationId" : "updatePatientContact",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ContactRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PatientResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Edycja danych kontaktowych pacjenta",
        "tags" : [ "patient-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ContactRequest" : {
        "type" : "object",
        "properties" : {
          "contactEmail" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          }
        }
      },
      "CreatePatientRequest" : {
        "type" : "object",
        "properties" : {
          "birthDate" : {
            "type" : "string",
            "format" : "date"
          },
          "contactEmail" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "firstName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "lastName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "birthDate", "firstName", "lastName" ]
      },
      "HealthResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string"
          }
        },
        "required" : [ "status" ]
      },
      "PageResponsePatientResponse" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PatientResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "total" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "items", "page", "size", "total" ]
      },
      "PatientResponse" : {
        "type" : "object",
        "properties" : {
          "birthDate" : {
            "type" : "string",
            "format" : "date"
          },
          "contactEmail" : {
            "type" : "string"
          },
          "firstName" : {
            "type" : "string"
          },
          "hasAccount" : {
            "type" : "boolean"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lastName" : {
            "type" : "string"
          }
        },
        "required" : [ "birthDate", "firstName", "hasAccount", "id", "lastName" ]
      },
      "SearchRequest" : {
        "type" : "object",
        "properties" : {
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "query" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "query" ]
      }
    }
  }
}
