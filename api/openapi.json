{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Wersja demonstracyjna, dane wyłącznie syntetyczne.",
    "title" : "Przychodnia360 API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "description" : "Dostęp: publiczny. Zwraca token dostępu i ustawia ciasteczko odświeżania.",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Logowanie do placówki",
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "description" : "Dostęp: zalogowany. Unieważnia rodzinę tokenów odświeżania i usuwa ciasteczko.",
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "p360_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Wylogowanie",
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/v1/auth/platform/login" : {
      "post" : {
        "description" : "Dostęp: publiczny.",
        "operationId" : "loginPlatformAdmin",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PlatformLoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Logowanie administratora platformy",
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "description" : "Dostęp: publiczny, wymaga ciasteczka odświeżania. Rotuje token odświeżania.",
        "operationId" : "refreshToken",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "p360_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Odświeżenie tokenu",
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/v1/facilities" : {
      "get" : {
        "description" : "Dostęp: publiczny (wybór placówki przy logowaniu).",
        "operationId" : "listFacilities",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/FacilityResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Lista aktywnych placówek",
        "tags" : [ "facility-controller" ]
      }
    },
    "/api/v1/health" : {
      "get" : {
        "description" : "Dostęp: publiczny.",
        "operationId" : "getHealth",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Stan aplikacji (bez bazy)",
        "tags" : [ "health-controller" ]
      }
    },
    "/api/v1/health/db" : {
      "get" : {
        "description" : "Dostęp: publiczny w local/test.",
        "operationId" : "getHealthDb",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Stan aplikacji z zapytaniem do bazy (tylko local/test)",
        "tags" : [ "health-controller" ]
      }
    },
    "/api/v1/me" : {
      "get" : {
        "description" : "Dostęp: każdy zalogowany użytkownik.",
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Bieżący użytkownik",
        "tags" : [ "me-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "FacilityResponse" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          }
        }
      },
      "HealthResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string"
          }
        }
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "tenantSlug" : {
            "type" : "string",
            "maxLength" : 63,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password", "tenantSlug" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "employeeId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "patientId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "PATIENT", "DOCTOR", "MEDICAL_STAFF", "RECEPTIONIST", "TENANT_ADMIN", "PLATFORM_ADMIN" ]
          },
          "slotStepMinutes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "tenantId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "tenantName" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "PlatformLoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "TokenResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          },
          "tokenType" : {
            "type" : "string"
          }
        }
      }
    }
  }
}
