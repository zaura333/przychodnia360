# Lokalne środowisko deweloperskie. Skopiuj do .env (plik .env jest w .gitignore).
# Wszystkie wartości są lokalne i syntetyczne; nie używaj ich nigdzie poza dockerem na własnej maszynie.

# --- PostgreSQL ---
POSTGRES_PORT=5432
# Superużytkownik kontenera (używany tylko przez skrypt init)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev
POSTGRES_DB=postgres
# Bazy usług (po jednej na usługę, ADR-M05) i rola właściciela (Flyway); tworzone przez docker/postgres/init
P360_DB_NAMES=p360_iam,p360_catalog,p360_scheduling
P360_OWNER_PASSWORD=p360_owner_local_dev
# Hasło roli aplikacji p360_app (rola powstaje w migracji Flyway V1; backend czyta zmienną P360_APP_PASSWORD)
P360_APP_PASSWORD=p360_app_local_dev

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Krawędź (Traefik) i usługi backendu ---
# Publiczny port backendu (krawędź); usługi w profilu full nie wystawiają własnych portów
BACKEND_PORT=8080
# Nagłówek wewnętrznego API między usługami (ADR-M07); ta sama wartość we wszystkich usługach
P360_INTERNAL_TOKEN=local-dev-internal-token
# Usługi uruchomione z IDE (porty 8091-8093) zamiast kontenerów: odkomentuj, żeby krawędź kierowała do hosta
# P360_IAM_URL=http://host.docker.internal:8091
# P360_CATALOG_URL=http://host.docker.internal:8092
# P360_SCHEDULING_URL=http://host.docker.internal:8093
