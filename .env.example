# Lokalne środowisko deweloperskie. Skopiuj do .env (plik .env jest w .gitignore).
# Wszystkie wartości są lokalne i syntetyczne; nie używaj ich nigdzie poza dockerem na własnej maszynie.

# --- PostgreSQL ---
POSTGRES_PORT=5432
# Superużytkownik kontenera (używany tylko przez skrypt init)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev
POSTGRES_DB=postgres
# Baza aplikacji i rola właściciela (Flyway); tworzone przez docker/postgres/init
P360_DB_NAME=p360
P360_OWNER_PASSWORD=p360_owner_local_dev
# Hasło roli aplikacji p360_app (rola powstaje w migracji Flyway V1; backend czyta zmienną P360_APP_PASSWORD)
P360_APP_PASSWORD=p360_app_local_dev

# --- Baza per usługa (zadanie 1.10), opcjonalnie ---
# Lista usług (po przecinku) tworzy przy pierwszym starcie bazę p360_<usługa> i właściciela p360_<usługa>_owner.
# Hasło: P360_<USŁUGA>_OWNER_PASSWORD (wielkie litery, "-" jako "_"). Przykład:
# P360_SERVICE_DATABASES=catalog,patient,iam,notification (domyślnie: catalog,patient,iam; bazy p360_catalog, p360_patient
# i p360_iam, hasła poniżej)
# P360_CATALOG_OWNER_PASSWORD=p360_catalog_owner_local_dev
# P360_CATALOG_APP_PASSWORD=p360_catalog_app_local_dev
# P360_PATIENT_OWNER_PASSWORD=p360_patient_owner_local_dev
# P360_PATIENT_APP_PASSWORD=p360_patient_app_local_dev
# P360_IAM_OWNER_PASSWORD=p360_iam_owner_local_dev
# P360_IAM_APP_PASSWORD=p360_iam_app_local_dev
# P360_NOTIFICATION_OWNER_PASSWORD=notification_owner_local_dev
# P360_INTEGRATION_HUB_OWNER_PASSWORD=integration_hub_owner_local_dev

# --- Tokeny usługowe (S3, ADR-M17), opcjonalnie ---
# Sekret, za który usługa scheduling (dziś clinic-core) dostaje od iam tokeny usługowe; ten sam w obu usługach.
# P360_SCHEDULING_CLIENT_SECRET=p360_scheduling_client_local_dev
# Port iam w kontenerze (z IDE scheduling woła iam pod localhost:8084)
# IAM_PORT=8084

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Backend w kontenerze (profil compose full) ---
BACKEND_PORT=8080
